# Explicit local demo. Do not put credentials in this file.
DEMO_MODE=true
AGENT_PROVIDER=demo
SAFETY_PROVIDER=local
HOST=127.0.0.1
PORT=8080

# Google runtime (ADC / workload identity; no service-account JSON key).
# Do not copy this local demo environment into Cloud Run.
# Cloud Run requires HOST=0.0.0.0; PORT is injected by the platform.
# Set DEMO_MODE=false and DATA_PROVIDER=bigquery for the event dataset.
# Studio verified model/global; backend ADC still requires validation.
GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
BIGQUERY_LOCATION=us-central1
# DATA_PROVIDER=bigquery
# PINGO_BOUND_PERSONA=persona-a
# PINGO_AUTHORIZED_USERS={"persona-a":"APPROVED_SYNTHETIC_ID_FROM_EVENT"}
# MODEL_ARMOR_TEMPLATE=projects/YOUR_GCP_PROJECT_ID/locations/us-central1/templates/pingo-safety
# MODEL_ARMOR_ENFORCEMENT=INSPECT_ONLY

# Application does not load dotenv implicitly: export variables explicitly.
# Never enable capture of prompts/responses in ADK or external instrumentation.

# Golden persona (server-bound synthetic event identity, new Cloud Run revision).
# DEMO_MODE=true
# DATA_PROVIDER=bigquery
# AGENT_PROVIDER=gemini
# DEMO_USER_ID=SYNTHETIC_DEMO_USER_ID
# DEMO_REFERENCE_DATE=2025-09-30
# HOST=0.0.0.0
# Offline tests only: DATA_PROVIDER=golden_fixture, AGENT_PROVIDER=demo.
# tests/fixtures/golden_persona.json is never packaged; K_SERVICE forbids this provider.
